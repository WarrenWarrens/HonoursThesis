{
  "manifest_version": 2,
  "name": "Firefox Screen Streamer",
  "version": "1.1",
  "description": "Share your screen to a WebSocket server for multi-viewer streaming.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "*://honoursthesisstreambackend.onrender.com/*",
    "*://*.vercel.app/*"
  ],
  "browser_action": {
    "default_icon": {
      "48": "icons/icon.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icons/icon.png"
  },
  "web_accessible_resources": [
    "capture.html"
  ],
  "applications": {
    "gecko": {
      "id": "firefoxscreenstreamer@example.com",
      "strict_min_version": "109.0"
    }
  },
  "content_security_policy": "script-src 'self' 'unsafe-eval' https://honoursthesisstreambackend.onrender.com; object-src 'self';"
}
